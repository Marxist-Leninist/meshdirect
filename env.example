# meshdirect environment example — copy to /etc/meshdirect-dev.env (root:root 0600).
# PROD cutover: COOKIE_SECURE=true, COOKIE_PATH=/qwen38, ORIGIN_ALLOW=https://zqx.lat,
# and prod creds reused from /etc/qwen38-mesh-gui.env.
NODE_ENV=production
HOST=127.0.0.1
PORT=31841
BASE_PATH=/qwen38
ORIGIN_ALLOW=https://zqx.lat,http://127.0.0.1:31841

# Cookie: name is __Secure-qwen_mesh_session when COOKIE_SECURE=true (prod),
# qwen_mesh_session otherwise (dev http loopback). COOKIE_PATH must be /qwen38 in prod
# (cookie contract), / is convenient in dev so the /api convenience mount also works.
COOKIE_SECURE=false
COOKIE_PATH=/
SESSION_TTL_MS=43200000

# bcrypt hash ($2b$12$...) — generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" '<password>'
APP_USERNAME=meshdev
APP_PASSWORD_HASH=$2b$12$REPLACE_ME_REPLACE_ME_REPLACE_ME_REPLACE_ME_REPLACE_ME_REPLA

MODEL_LABEL=Qwen 3.8 Mesh
PLAN_LABEL=Preview · Token Plan
WORKSPACE_LABEL=Stable · Token Plan

TURN_TIMEOUT_MS=600000
CONNECT_TIMEOUT_MS=10000
STALL_TIMEOUT_MS=60000
SSE_PING_MS=15000

# model egress via corporate proxy (HTTP CONNECT tunnel; direct egress is blocked)
HTTPS_PROXY=http://10.0.1.20:8899
NO_PROXY=127.0.0.1,localhost,::1,10.0.1.10,10.0.1.20,10.0.1.30

# optional overrides (fallback drill etc.):
# PRIMARY_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# FALLBACK_BASE_URL=https://ws-cigeu9sl07kxfsxh.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# PREVIEW_MODEL_ID=qwen3.8-max-preview
# STABLE_MODEL_ID=qwen3.8-max
# SYSTEM_PROMPT=...
